@page "/"
@page "/chat/{Id:guid}"
@using System.Diagnostics
@using ChatBot.Services.Rag
@implements IDisposable
@inject SessionStore Store
@inject ChatService ChatService
@inject LlmService Llm
@inject EmbeddingService Embedder
@inject DocumentLibrary Library
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_session?.Title ?? "ChatBot")</PageTitle>

<div class="app">
    <Sidebar Sessions="_sessions" ActiveId="_session?.Id" ShowDocuments="UseDocuments" OnNewChat="NewChat" OnDelete="DeleteSession" />

    <main class="chat">
        <header class="chat-header">
            <div class="mode-switch" role="radiogroup" aria-label="Answer mode">
                <button type="button" role="radio" aria-checked="@(!UseDocuments)" class="@(UseDocuments ? "" : "active")"
                        disabled="@(_isGenerating || _session is null)" title="General chat with the model; documents are not used"
                        @onclick="() => SetMode(useDocuments: false)">
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
                    Chatbot
                </button>
                <button type="button" role="radio" aria-checked="@UseDocuments" class="@(UseDocuments ? "active" : "")"
                        disabled="@(_isGenerating || _session is null)" title="Answer only from your documents, with page citations"
                        @onclick="() => SetMode(useDocuments: true)">
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zm0 0v5h5M9 13h6M9 17h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    Documents
                </button>
            </div>

            @if (UseDocuments)
            {
                <label class="scope">
                    <span>Search in</span>
                    <select value="@(SelectedDocumentId ?? "")" disabled="@_isGenerating" @onchange="SelectDocument">
                        <option value="">All documents</option>
                        @foreach (var doc in _documents)
                        {
                            <option value="@doc.Id">@doc.Title@(doc.Status == DocumentStatus.Ready ? "" : $" ({doc.Status.ToString().ToLowerInvariant()})")</option>
                        }
                    </select>
                </label>
                <span class="library-status @LibraryStatusClass">@LibraryStatusText</span>
                <span class="header-spacer"></span>
                <UploadButton Class="subtle" Label="Upload document" OnResult="errors => _uploadErrors = errors" />
            }
            else
            {
                <span class="mode-hint">General chat. Your documents are not used.</span>
            }
        </header>

        @if (UseDocuments && _uploadErrors.Count > 0)
        {
            <div class="upload-errors">
                @foreach (var error in _uploadErrors)
                {
                    <div>@error</div>
                }
                <button type="button" aria-label="Dismiss" @onclick="() => _uploadErrors = []">×</button>
            </div>
        }

        @if (!Llm.IsReady)
        {
            <div class="banner">
                <strong>The chat model is not available.</strong>
                <pre>@Llm.LoadError</pre>
            </div>
        }
        @if (UseDocuments && !Embedder.IsReady)
        {
            <div class="banner">
                <strong>The embedding model is not available, so documents can't be searched.</strong>
                <pre>@Embedder.LoadError</pre>
            </div>
        }

        <div class="messages" @ref="_messagesEl">
            <div class="column">
                @if (_session is not null && _messages.Count == 0 && !_isGenerating)
                {
                    <div class="welcome">
                        @if (UseDocuments)
                        {
                            <h1>Ask your documents</h1>
                            <p>Answers come only from the documents in the sidebar, with page citations. Try one of these:</p>
                        }
                        else
                        {
                            <h1>Hi! How can I help?</h1>
                            <p>Running Qwen3 locally on your CPU. Try one of these:</p>
                        }
                        <div class="examples">
                            @foreach (var example in Examples)
                            {
                                <button type="button" disabled="@(!CanSend)" @onclick="() => SendAsync(example)">@example</button>
                            }
                        </div>
                    </div>
                }

                @foreach (var message in _messages)
                {
                    <MessageBubble Role="message.Role" Content="@message.Content" Sources="message.Sources" />
                }

                @if (_isGenerating)
                {
                    if (_streamingText.Length > 0)
                    {
                        <MessageBubble Role="ChatRole.Assistant" Content="@_streamingText" />
                    }
                    <div class="status" role="status">
                        <span class="dots" aria-hidden="true"><span></span><span></span><span></span></span>
                        <span>@StatusText</span>
                    </div>
                }

                @if (_error is not null)
                {
                    <div class="error">@_error</div>
                }
            </div>
        </div>

        <form class="composer" @onsubmit="SendFromComposer">
            @if (BlockedReason is { } reason)
            {
                <p class="column hint">@reason</p>
            }
            <div class="column composer-box">
                <textarea @ref="_inputEl" @bind="_input" @bind:event="oninput" rows="1"
                          placeholder="@(UseDocuments ? "Ask about your documents (Enter to send, Shift+Enter for a new line)" : "Message ChatBot (Enter to send, Shift+Enter for a new line)")"
                          disabled="@(!Llm.IsReady)"></textarea>
                @if (_isGenerating)
                {
                    <button type="button" class="stop" @onclick="Stop">Stop</button>
                }
                else
                {
                    <button type="submit" disabled="@(!CanSend || string.IsNullOrWhiteSpace(_input))">Send</button>
                }
            </div>
        </form>
    </main>
</div>

@code {
    private static readonly string[] ChatExamples =
    [
        "What is RAG?",
        "Explain async/await in C# with a short example",
        "How do I make good coffee?",
        "Give me 5 ideas for a weekend project",
    ];

    private static readonly string[] GpoExamples =
    [
        "What does GPO do?",
        "How many passports did GPO produce in FY 2018?",
        "What was GPO's net income in FY 2018?",
        "How many employees did GPO have at the end of FY 2018?",
    ];

    [Parameter]
    public Guid? Id { get; set; }

    [CascadingParameter(Name = "UserId")]
    public string UserId { get; set; } = "";

    private IReadOnlyList<ChatSession> _sessions = [];
    private IReadOnlyList<DocumentInfo> _documents = [];
    private ChatSession? _session;
    private List<ChatMessage> _messages = [];

    private string _input = "";
    private string _streamingText = "";
    private string? _error;
    private bool _isGenerating;
    private ChatStage _stage;
    private CancellationTokenSource? _cts;
    private readonly Stopwatch _statusClock = new(); // time spent in the current stage

    private ElementReference _messagesEl;
    private ElementReference _inputEl;
    private bool _forceScroll = true;
    private bool _focusInput = true;

    private bool UseDocuments => _session?.UseDocuments ?? true;

    /// <summary>The session's chosen document, if it still exists.</summary>
    private string? SelectedDocumentId =>
        _session?.DocumentId is { } id && _documents.Any(d => d.Id == id) ? id : null;

    private string? BlockedReason
    {
        get
        {
            if (!Llm.IsReady || !UseDocuments || _isGenerating)
                return null;
            if (!Embedder.IsReady)
                return "Document search is unavailable (embedding model missing). Turn off \"Answer from documents\" to chat normally.";
            if (Library.HasReadyDocument(SelectedDocumentId))
                return null;
            if (SelectedDocumentId is not null)
                return "The selected document isn't ready yet. Wait for indexing to finish, or search all documents.";
            return _documents.FirstOrDefault(d => d.Status == DocumentStatus.Indexing) is { } indexing
                ? $"\"{indexing.Title}\" is being indexed ({indexing.Progress:P0}). You can ask as soon as it's ready. The first indexing takes a few minutes; after that it loads from the cache at startup."
                : "No documents are ready. Upload a PDF, DOCX, TXT or MD file, or switch to Chatbot mode.";
        }
    }

    private IReadOnlyList<string> _uploadErrors = [];

    /// <summary>"Indexing … 45%" while anything is indexing, otherwise how many documents are ready.</summary>
    private string LibraryStatusText
    {
        get
        {
            if (_documents.FirstOrDefault(d => d.Status == DocumentStatus.Indexing) is { } indexing)
                return indexing.Progress > 0 ? $"Indexing {indexing.Title} · {indexing.Progress:P0}" : $"Indexing {indexing.Title}…";
            var ready = _documents.Count(d => d.Status == DocumentStatus.Ready);
            return ready == 1 ? "1 document ready" : $"{ready} documents ready";
        }
    }

    private string LibraryStatusClass =>
        _documents.Any(d => d.Status == DocumentStatus.Indexing) ? "indexing"
        : _documents.Any(d => d.Status == DocumentStatus.Ready) ? "ready" : "empty";

    private bool CanSend =>Llm.IsReady && _session is not null && (!UseDocuments || (Embedder.IsReady && BlockedReason is null));

    private IReadOnlyList<string> Examples
    {
        get
        {
            if (!UseDocuments)
                return ChatExamples;
            var ready = _documents.Where(d => d.Status == DocumentStatus.Ready).ToList();
            if (ready.Any(d => d.Title.Contains("Publishing Office", StringComparison.OrdinalIgnoreCase)) && SelectedDocumentId is null)
                return GpoExamples;
            var title = (SelectedDocumentId is { } id ? _documents.First(d => d.Id == id) : ready.FirstOrDefault())?.Title ?? "the documents";
            return [$"Summarize the main points of {title}", $"What are the most important numbers in {title}?"];
        }
    }

    private string StatusText
    {
        get
        {
            if (_streamingText.Length > 0)
                return "Typing…";

            var label = _stage switch
            {
                ChatStage.WaitingForModel => "Waiting for the model…",
                ChatStage.Searching => "Searching documents…",
                _ => "Thinking…",
            };
            var seconds = (int)_statusClock.Elapsed.TotalSeconds;
            return seconds < 3 ? label : $"{label} {seconds}s";
        }
    }

    protected override void OnInitialized()
    {
        Store.Changed += OnStoreChanged;
        Library.Changed += OnLibraryChanged;
        _documents = Library.List();
    }

    protected override void OnParametersSet()
    {
        if (_session is not null && _session.Id == Id)
            return;

        // Switching sessions stops any reply in progress (the partial reply is saved).
        _cts?.Cancel();
        ResetGenerationState();
        _error = null;
        _sessions = Store.List(UserId);

        var session = Id is { } id ? Store.Get(id, UserId) : null;
        if (session is null)
        {
            // "/" opens the latest session; an unknown ID gets a fresh one.
            session = Id is null ? _sessions.FirstOrDefault() : null;
            session ??= Store.Create(UserId);
            Nav.NavigateTo($"chat/{session.Id}", replace: true);
            return;
        }

        _session = session;
        _messages = Store.GetMessages(session).ToList();
        _forceScroll = true;
        _focusInput = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("chat.initComposer", _inputEl);

        await JS.InvokeVoidAsync("chat.scrollToBottom", _messagesEl, _forceScroll);
        _forceScroll = false;

        if (_focusInput)
        {
            _focusInput = false;
            await JS.InvokeVoidAsync("chat.focus", _inputEl);
        }
    }

    private Task SendFromComposer() => SendAsync(_input);

    private async Task SendAsync(string text)
    {
        text = text.Trim();
        if (text.Length == 0 || _isGenerating || !CanSend || _session is null)
            return;

        var session = _session;
        session.DocumentId = SelectedDocumentId; // forget a deleted document
        var cts = new CancellationTokenSource();
        _cts = cts;
        _input = "";
        _error = null;
        _streamingText = "";
        _isGenerating = true;
        _stage = Llm.IsBusy ? ChatStage.WaitingForModel : session.UseDocuments ? ChatStage.Searching : ChatStage.Thinking;
        _messages.Add(new ChatMessage(ChatRole.User, text)); // shown right away; the store copy is reloaded below
        _forceScroll = true;
        _statusClock.Restart();
        StateHasChanged();

        // Re-render once a second so the elapsed time in the status line keeps counting.
        using var ticker = new Timer(_ => InvokeAsync(StateHasChanged), null, 1000, 1000);

        var sinceRender = Stopwatch.StartNew();
        try
        {
            await ChatService.SendAsync(session, text,
                onStage: stage => InvokeAsync(() =>
                {
                    if (_cts != cts || _stage == stage) return;
                    _stage = stage;
                    _statusClock.Restart();
                    StateHasChanged();
                }),
                onText: reply =>
                {
                    if (_cts != cts) return;
                    _streamingText = reply;
                    // Throttle UI updates to roughly every 50 ms.
                    if (sinceRender.ElapsedMilliseconds >= 50)
                    {
                        sinceRender.Restart();
                        InvokeAsync(StateHasChanged);
                    }
                },
                cts.Token);
        }
        catch (Exception ex)
        {
            if (_cts == cts)
                _error = $"Something went wrong: {ex.Message}";
        }
        finally
        {
            if (_cts == cts)
            {
                ResetGenerationState();
                _messages = Store.GetMessages(session).ToList();
                _focusInput = true;
            }
            cts.Dispose();
        }
    }

    private void Stop() => _cts?.Cancel();

    private void ResetGenerationState()
    {
        _cts = null;
        _isGenerating = false;
        _streamingText = "";
    }

    private void SetMode(bool useDocuments)
    {
        if (_session is null || _isGenerating)
            return;
        _session.UseDocuments = useDocuments;
        _sessions = Store.List(UserId); // refresh the mode icon in the sidebar
        _focusInput = true;
    }

    private void SelectDocument(ChangeEventArgs e)
    {
        if (_session is not null)
            _session.DocumentId = e.Value is string id && id.Length > 0 ? id : null;
    }

    private void NewChat()
    {
        // A new chat starts in the mode you are using now.
        var session = Store.Create(UserId);
        session.UseDocuments = UseDocuments;
        Nav.NavigateTo($"chat/{session.Id}");
    }

    private void DeleteSession(Guid id)
    {
        if (id == _session?.Id)
        {
            _cts?.Cancel();
            ResetGenerationState();
        }

        Store.Delete(id, UserId);

        if (id == _session?.Id)
        {
            _session = null;
            Nav.NavigateTo("/", replace: true);
        }
    }

    private void OnStoreChanged(string userId)
    {
        if (userId != UserId)
            return;

        _ = InvokeAsync(() =>
        {
            _sessions = Store.List(UserId);

            // Keep the view in sync with other tabs, but don't disturb a reply being streamed here.
            if (_session is not null && !_isGenerating)
            {
                if (Store.Get(_session.Id, UserId) is null)
                {
                    _session = null;
                    Nav.NavigateTo("/", replace: true);
                    return;
                }
                _messages = Store.GetMessages(_session).ToList();
            }
            StateHasChanged();
        });
    }

    private void OnLibraryChanged() => _ = InvokeAsync(() =>
    {
        _documents = Library.List();
        StateHasChanged();
    });

    public void Dispose()
    {
        Store.Changed -= OnStoreChanged;
        Library.Changed -= OnLibraryChanged;
        _cts?.Cancel();
    }
}
